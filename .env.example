# ---------------------------------------------------------------------------
# Al Ashkar — site configuration
#
# Copy to .env.local and fill in the shop's REAL details.
# Anything left blank is hidden in the UI rather than shown as a fake value.
# ---------------------------------------------------------------------------

# WhatsApp number, digits only, including country code (no +, no spaces)
VITE_WHATSAPP_NUMBER=

# Displayed contact details
VITE_PHONE=
VITE_EMAIL=
VITE_ADDRESS=
VITE_HOURS=
VITE_MAPS_URL=

# Social profiles (optional)
VITE_INSTAGRAM_URL=
VITE_X_URL=
VITE_SNAPCHAT_URL=
VITE_TIKTOK_URL=

# Supabase — order form submissions
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_ORDERS_TABLE=thobe_orders
